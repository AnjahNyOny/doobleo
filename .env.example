# ─── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=doobleo
POSTGRES_PASSWORD=doobleo_secret
POSTGRES_DB=doobleo_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://doobleo:doobleo_secret@localhost:5432/doobleo_dev

# ─── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Authentification ─────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NUXT_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ─── Stockage médias (Cloudflare R2 ou AWS S3) ────────────────────────────────
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=doobleo-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# URL publique de ton bucket (pour les URLs de téléchargement)
S3_PUBLIC_URL=https://media.doobleo.com

# ─── FFmpeg (mixage vidéo) ────────────────────────────────────────────────────
# Chemin vers l'exécutable ffmpeg (laisser vide si dans le PATH)
FFMPEG_PATH=

# ─── URL de l'app (pour les redirections OAuth, emails, etc.) ─────────────────
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Socket.io ───────────────────────────────────────────────────────────────
# En prod, mettre l'URL du serveur backend Railway/Render
NUXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ─── OAuth (optionnel) ────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

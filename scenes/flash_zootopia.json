  "lines": [
    {
      "id": "line-1",
      "characterId": "char-unknown",
      "text": "Flash, c'est le type le plus rapide là dedans. T'as besoin d'un truc ?",
      "startMs": 0,
      "endMs": 4000,
      "order": 1
    },
    {
      "id": "line-2",
      "characterId": "char-unknown",
      "text": "J'espère bien. C'est une course contre la montra, alors chaque minute compte.",
      "startMs": 4000,
      "endMs": 8000,
      "order": 2
    },
    {
      "id": "line-3",
      "characterId": "char-unknown",
      "text": "Attendez, y'a que des paraissus ?",
      "startMs": 8000,
      "endMs": 11000,
      "order": 3
    },
    {
      "id": "line-4",
      "characterId": "char-unknown",
      "text": "Vous avez dit que ce serait rapide ?",
      "startMs": 30000,
      "endMs": 32000,
      "order": 4
    },
    {
      "id": "line-5",
      "characterId": "char-unknown",
      "text": "Quoi ? Tu veux dire que parce que c'est un paraisseur, il peut pas être rapide ?",
      "startMs": 32000,
      "endMs": 35000,
      "order": 5
    },
    {
      "id": "line-6",
      "characterId": "char-unknown",
      "text": "Qu'est-ce qu'a dit Casottopi ? Chacun peut être ce qu'il veut.",
      "startMs": 35000,
      "endMs": 38000,
      "order": 6
    },
    {
      "id": "line-7",
      "characterId": "char-unknown",
      "text": "Flash, Flash ! Rapide comme une flèche !",
      "startMs": 38000,
      "endMs": 40000,
      "order": 7
    },
    {
      "id": "line-8",
      "characterId": "char-unknown",
      "text": "Mon gars, je suis content de te voir.",
      "startMs": 40000,
      "endMs": 42000,
      "order": 8
    },
    {
      "id": "line-9",
      "characterId": "char-unknown",
      "text": "Content de te voir... aussi.",
      "startMs": 42000,
      "endMs": 49000,
      "order": 9
    },
    {
      "id": "line-10",
      "characterId": "char-unknown",
      "text": "Flash, j'aimerais te voir.",
      "startMs": 49000,
      "endMs": 51000,
      "order": 10
    },
    {
      "id": "line-11",
      "characterId": "char-unknown",
      "text": "Je suis réellement oublié ton nom.",
      "startMs": 51000,
      "endMs": 54000,
      "order": 11
    },
    {
      "id": "line-12",
      "characterId": "char-unknown",
      "text": "Lieutenant Judy Hopps, police de Zotopee, comment ça va ?",
      "startMs": 54000,
      "endMs": 57000,
      "order": 12
    },
    {
      "id": "line-13",
      "characterId": "char-unknown",
      "text": "Disons que je vais...",
